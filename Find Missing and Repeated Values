class Solution {
public:
    vector<int> findMissingAndRepeatedValues(vector<vector<int>>& grid) {
        vector<int>ans;
        int n = grid.size();

        unordered_set<int> s;
        int a,b;
        int ac=0;

        for(int i =0;i<n;i++){
            for(int j =0;j<n;j++){
                if(s.find(grid[i][j]) != s.end()){
                    a=grid[i][j];
                    ans.push_back(a);
                    break;
                }
                s.insert(grid[i][j]);
            }
        }
        for(int i =0;i<n;i++){
            for(int j =0;j<n;j++){
                ac+=grid[i][j];
            }
        }

        int e_c = pow(n, 2)*(pow(n, 2) + 1)/2;
        b = e_c +a-ac;
        ans.push_back(b);

        return ans;

    }
};
